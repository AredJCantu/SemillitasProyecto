<?xml version="1.0" encoding="utf-8" ?>
<!--
    Cobranza (solo lectura, no marca pagos). BindingContext: InscripcionesViewModel.
    Lee: Periodos, PeriodoSeleccionado, Cobrado, PorCobrar, AlumnosConAdeudo,
         Filtros (textos), FiltroSeleccionado, IsBusy, Cobros[Tutor, Alumno, Taller, Costo, Estado, Tono]
    Command: CargarCommand (al aparecer)
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:vm="clr-namespace:SemillitasMobileApp.ViewModels"
             xmlns:b="clr-namespace:SemillitasMobileApp.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SemillitasMobileApp.Views.CobranzaView"
             Title="Cobranza"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:InscripcionesViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Behaviors>
        <b:AlAparecerBehavior Command="{Binding CargarCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Color x:Key="Fondo">#F7F5EF</Color>
        <Color x:Key="Blanco">#FFFFFF</Color>
        <Color x:Key="Tinta">#1F2A24</Color>
        <Color x:Key="TintaSuave">#5A655E</Color>
        <Color x:Key="Linea">#E2DED2</Color>
        <Color x:Key="BordeCampo">#CFCABB</Color>
        <Color x:Key="Primario">#2A6F4F</Color>
        <Color x:Key="VerdeFondo">#DDEFE4</Color>
        <Color x:Key="VerdeTexto">#1E5A3D</Color>
        <Color x:Key="RojoFondo">#F6D9D2</Color>
        <Color x:Key="RojoTexto">#8E2A17</Color>

        <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta}" /></Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Nota" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource Linea}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource BordeCampo}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="20" /></Setter.Value></Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
                                <Setter Property="Stroke" Value="{StaticResource Primario}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="HeightRequest" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HorizontalOptions" Value="End" />
            <Setter Property="VerticalOptions" Value="Start" />
            <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="14" /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="BackgroundColor" Value="{StaticResource RojoFondo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeTexto" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource VerdeTexto}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12" Padding="16,16,16,0"
          BackgroundColor="{StaticResource Fondo}">

        <!-- Título + período -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="Cobranza" Style="{StaticResource Titulo}" VerticalOptions="Center" />
            <Picker Grid.Column="1" ItemsSource="{Binding Periodos}"
                    SelectedItem="{Binding PeriodoSeleccionado}" Title="Período" WidthRequest="150" />
        </Grid>

        <!-- Totales -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <Border Style="{StaticResource Tarjeta}" Padding="14">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Cobrado" Style="{StaticResource Nota}" />
                    <Label Text="{Binding Cobrado}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource VerdeTexto}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="14"
                    BackgroundColor="{StaticResource RojoFondo}" StrokeThickness="0">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Por cobrar" Style="{StaticResource Nota}" TextColor="{StaticResource RojoTexto}" />
                    <Label Text="{Binding PorCobrar}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RojoTexto}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Tarjeta}" Padding="14,12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Alumnos con adeudo" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding AlumnosConAdeudo}" FontSize="20" FontAttributes="Bold" />
                </Grid>
            </Border>
        </Grid>

        <!-- Filtros -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Filtros}" SelectionMode="Single"
                        SelectedItem="{Binding FiltroSeleccionado}" HeightRequest="48">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Chip}">
                        <Label Text="{Binding .}" FontAttributes="Bold" VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Lista de tarjetas -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Cobros}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay inscripciones con este filtro." Style="{StaticResource Nota}"
                       HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Alumno}" FontSize="17" FontAttributes="Bold" />
                                    <Label Text="{Binding Tutor, StringFormat='Tutor: {0}'}" Style="{StaticResource Nota}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource BadgeBorder}">
                                    <Label Text="{Binding Estado}" Style="{StaticResource BadgeTexto}" />
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Taller}" Style="{StaticResource Nota}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Costo}" FontSize="20" FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primario}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
