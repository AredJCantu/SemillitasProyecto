<?xml version="1.0" encoding="utf-8" ?>
<!--
    Disponibilidad (consulta, solo lectura).
    Lee: Periodos, PeriodoSeleccionado, TextoBusqueda, ConteoConCupo, ConteoPocos, ConteoLlenos,
         Categorias[Texto], CategoriaSeleccionada, IsBusy,
         Talleres[Nombre, Meta, Horario, Ocupacion, Porcentaje (0-1), Badge, Tono]
    Meta = "Categoría · Instructor · $costo"; Horario = "3–5 pm"; Tono = Verde | Ambar | Rojo
    Sin Commands.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:vm="clr-namespace:SemillitasMobileApp.Viewmodels"
             xmlns:b="clr-namespace:SemillitasMobileApp.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SemillitasMobileApp.Views.AndroidViews.MainView"
             Title="Disponibilidad"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:DisponibilidadViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Behaviors>
        <b:AlAparecerBehavior Command="{Binding CargarCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Color x:Key="Fondo">#F7F5EF</Color>
        <Color x:Key="Blanco">#FFFFFF</Color>
        <Color x:Key="Tinta">#1F2A24</Color>
        <Color x:Key="TintaSuave">#5A655E</Color>
        <Color x:Key="Linea">#E2DED2</Color>
        <Color x:Key="BordeCampo">#CFCABB</Color>
        <Color x:Key="Primario">#2A6F4F</Color>
        <Color x:Key="VerdeFondo">#DDEFE4</Color>
        <Color x:Key="VerdeTexto">#1E5A3D</Color>
        <Color x:Key="VerdeBarra">#2A6F4F</Color>
        <Color x:Key="AmbarFondo">#FBEBC4</Color>
        <Color x:Key="AmbarTexto">#7A4B00</Color>
        <Color x:Key="AmbarBarra">#D99A1E</Color>
        <Color x:Key="RojoFondo">#F6D9D2</Color>
        <Color x:Key="RojoTexto">#8E2A17</Color>
        <Color x:Key="RojoBarra">#B23A24</Color>

        <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta}" /></Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="SearchBar">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
        </Style>

        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Nota" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource Linea}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        </Style>

        <!-- Chip de categoría (se ve distinto al estar Selected) -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource BordeCampo}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="20" /></Setter.Value></Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
                                <Setter Property="Stroke" Value="{StaticResource Primario}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="HeightRequest" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HorizontalOptions" Value="End" />
            <Setter Property="VerticalOptions" Value="Start" />
            <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="14" /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding Tono}" Value="Ambar">
                    <Setter Property="BackgroundColor" Value="{StaticResource AmbarFondo}" />
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="BackgroundColor" Value="{StaticResource RojoFondo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeTexto" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource VerdeTexto}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="Ambar">
                    <Setter Property="TextColor" Value="{StaticResource AmbarTexto}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BarraProgreso" TargetType="ProgressBar">
            <Setter Property="ProgressColor" Value="{StaticResource VerdeBarra}" />
            <Style.Triggers>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding Tono}" Value="Ambar">
                    <Setter Property="ProgressColor" Value="{StaticResource AmbarBarra}" />
                </DataTrigger>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="ProgressColor" Value="{StaticResource RojoBarra}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12" Padding="16,16,16,0"
          BackgroundColor="{StaticResource Fondo}">

        <!-- Título + período -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="Disponibilidad" Style="{StaticResource Titulo}" VerticalOptions="Center" />
            <Picker Grid.Column="1" ItemsSource="{Binding Periodos}"
                    SelectedItem="{Binding PeriodoSeleccionado}" Title="Período" WidthRequest="130" />
        </Grid>

        <!-- Buscador -->
        <SearchBar Grid.Row="1" Text="{Binding TextoBusqueda}" Placeholder="Buscar taller" />

        <!-- Resumen (3 contadores iguales) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Border Style="{StaticResource Tarjeta}" Padding="10" BackgroundColor="{StaticResource VerdeFondo}" StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="{Binding ConteoConCupo}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource VerdeTexto}" HorizontalOptions="Center" />
                    <Label Text="con cupo" Style="{StaticResource Nota}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="10" BackgroundColor="{StaticResource AmbarFondo}" StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="{Binding ConteoPocos}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource AmbarTexto}" HorizontalOptions="Center" />
                    <Label Text="pocos lugares" Style="{StaticResource Nota}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="10" BackgroundColor="{StaticResource RojoFondo}" StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="{Binding ConteoLlenos}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource RojoTexto}" HorizontalOptions="Center" />
                    <Label Text="llenos" Style="{StaticResource Nota}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Chips de categoría -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Categorias}" SelectionMode="Single"
                        SelectedItem="{Binding CategoriaSeleccionada}" HeightRequest="48">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Chip}">
                        <Label Text="{Binding Texto}" FontAttributes="Bold" VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Lista de tarjetas -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding Talleres}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No hay talleres con estos filtros." Style="{StaticResource Nota}"
                       HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Nombre}" FontSize="17" FontAttributes="Bold" />
                                    <Label Text="{Binding Meta}" Style="{StaticResource Nota}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource BadgeBorder}">
                                    <Label Text="{Binding Badge}" Style="{StaticResource BadgeTexto}" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding Horario}" Style="{StaticResource Nota}" />
                            <ProgressBar Progress="{Binding Porcentaje}" Style="{StaticResource BarraProgreso}" />
                            <Label Text="{Binding Ocupacion}" Style="{StaticResource Nota}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="4" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primario}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
