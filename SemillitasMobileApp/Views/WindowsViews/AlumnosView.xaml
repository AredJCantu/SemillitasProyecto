<?xml version="1.0" encoding="utf-8" ?>
<!--
    Lista de alumnos.
    Lee: TextoBusqueda, IsBusy, ResumenListado,
         Alumnos[NombreCompleto, Tutor (nombre y apellido), Telefono, CantidadTalleres, Estado, Tono]
    Estado = Debe | Al corriente; Tono = Rojo | Verde
    Commands: NuevoAlumnoCommand, VerDetalleAlumnoCommand (fila)
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:vm="clr-namespace:SemillitasMobileApp.Viewmodels"
             xmlns:b="clr-namespace:SemillitasMobileApp.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:wViews="clr-namespace:SemillitasMobileApp.Views.WindowsViews"
             x:Class="SemillitasMobileApp.Views.WindowsViews.AlumnosView"
             Title="Alumnos">

    <ContentPage.BindingContext>
        <vm:AlumnosViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Behaviors>
        <b:AlAparecerBehavior Command="{Binding CargarCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Color x:Key="Fondo">#F7F5EF</Color>
        <Color x:Key="Blanco">#FFFFFF</Color>
        <Color x:Key="Tinta">#1F2A24</Color>
        <Color x:Key="TintaSuave">#5A655E</Color>
        <Color x:Key="Linea">#E2DED2</Color>
        <Color x:Key="BordeCampo">#CFCABB</Color>
        <Color x:Key="Primario">#2A6F4F</Color>
        <Color x:Key="VerdeFondo">#DDEFE4</Color>
        <Color x:Key="VerdeTexto">#1E5A3D</Color>
        <Color x:Key="RojoFondo">#F6D9D2</Color>
        <Color x:Key="RojoTexto">#8E2A17</Color>

        <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta}" /></Style>
        <Style TargetType="SearchBar">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Subtitulo" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Nota" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource Linea}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="18,0" />
        </Style>
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="BorderColor" Value="{StaticResource BordeCampo}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="15" /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="BackgroundColor" Value="{StaticResource RojoFondo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeTexto" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource VerdeTexto}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <!-- Menú (232) + contenido -->
    <Grid ColumnDefinitions="232,*">
        <wViews:MenuLateral Activo="Alumnos" />
        <Grid Grid.Column="1">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16" Padding="32,24"
              BackgroundColor="{StaticResource Fondo}">

            <!-- Encabezado -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Alumnos" Style="{StaticResource Titulo}" />
                    <Label Text="Consulta alumnos, tutores y sus talleres." Style="{StaticResource Subtitulo}" />
                </VerticalStackLayout>

                <Button Grid.Column="1" Text="+ Nuevo alumno" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoAlumnoCommand}" VerticalOptions="End" />
            </Grid>

            <!-- Búsqueda -->
            <SearchBar Grid.Row="1" Text="{Binding TextoBusqueda}" Placeholder="Buscar alumno, tutor o teléfono"
                       HorizontalOptions="Start" WidthRequest="400" />

            <!-- Tabla -->
            <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0">
                <Grid RowDefinitions="Auto,*">

                    <Grid ColumnDefinitions="2*,1.6*,1.3*,90,130,130" ColumnSpacing="16" Padding="20,0"
                          HeightRequest="40" BackgroundColor="{StaticResource Fondo}">
                        <Label Text="ALUMNO" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="TUTOR" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="TELÉFONO" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="TALLERES" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="4" Text="ESTADO" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding Alumnos}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No hay alumnos que coincidan." Style="{StaticResource Subtitulo}"
                                   HorizontalOptions="Center" Margin="0,40" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,1.6*,1.3*,90,130,130" ColumnSpacing="16"
                                      Padding="20,0" HeightRequest="60">

                                    <Label Text="{Binding NombreCompleto}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Tutor}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Telefono}" Style="{StaticResource Nota}" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding CantidadTalleres}" FontAttributes="Bold" VerticalOptions="Center" />

                                    <Border Grid.Column="4" Style="{StaticResource BadgeBorder}">
                                        <Label Text="{Binding Estado}" Style="{StaticResource BadgeTexto}" />
                                    </Border>

                                    <Button Grid.Column="5" Text="Ver detalle" Style="{StaticResource BotonSecundario}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerDetalleAlumnoCommand}" CommandParameter="{Binding .}"
                                            VerticalOptions="Center" />

                                    <BoxView Grid.ColumnSpan="6" HeightRequest="1" Color="{StaticResource Linea}"
                                             VerticalOptions="End" Margin="-20,0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primario}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Pie -->
            <Label Grid.Row="3" Text="{Binding ResumenListado}" Style="{StaticResource Nota}" />
        </Grid>
        </Grid>
    </Grid>
</ContentPage>
