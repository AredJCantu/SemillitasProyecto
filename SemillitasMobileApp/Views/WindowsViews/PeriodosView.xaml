<?xml version="1.0" encoding="utf-8" ?>
<!--
    Lista de períodos (MesInicio – MesFin).
    Lee: IsBusy, Periodos[MesInicio, MesFin, CantidadTalleres]
    Commands: NuevoPeriodoCommand, EditarPeriodoCommand (fila)
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:vm="clr-namespace:SemillitasMobileApp.Viewmodels"
             xmlns:b="clr-namespace:SemillitasMobileApp.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:wViews="clr-namespace:SemillitasMobileApp.Views.WindowsViews"
             x:Class="SemillitasMobileApp.Views.WindowsViews.PeriodosView"
             Title="Períodos">

    <ContentPage.BindingContext>
        <vm:PeriodosViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Behaviors>
        <b:AlAparecerBehavior Command="{Binding CargarCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Color x:Key="Fondo">#F7F5EF</Color>
        <Color x:Key="Blanco">#FFFFFF</Color>
        <Color x:Key="Tinta">#1F2A24</Color>
        <Color x:Key="TintaSuave">#5A655E</Color>
        <Color x:Key="Linea">#E2DED2</Color>
        <Color x:Key="BordeCampo">#CFCABB</Color>
        <Color x:Key="Primario">#2A6F4F</Color>
        <Color x:Key="RojoTexto">#8E2A17</Color>

        <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta}" /></Style>
        <Style TargetType="SearchBar">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Subtitulo" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Nota" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource Linea}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="18,0" />
        </Style>
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="BorderColor" Value="{StaticResource BordeCampo}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <!-- Botón de peligro -->
        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
            <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
        </Style>
    </ContentPage.Resources>

    <!-- Menú (232) + contenido -->
    <Grid ColumnDefinitions="232,*">
        <wViews:MenuLateral Activo="Periodos" />
        <Grid Grid.Column="1">
        <Grid RowDefinitions="Auto,*" RowSpacing="16" Padding="32,24" BackgroundColor="{StaticResource Fondo}">

            <!-- Encabezado -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Períodos" Style="{StaticResource Titulo}" />
                    <Label Text="Los talleres se ofrecen dentro de un período." Style="{StaticResource Subtitulo}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="+ Nuevo período" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoPeriodoCommand}" VerticalOptions="End" />
            </Grid>

            <!-- Tabla -->
            <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,*,120,130" ColumnSpacing="16" Padding="20,0"
                          HeightRequest="40" BackgroundColor="{StaticResource Fondo}">
                        <Label Text="MES DE INICIO" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="MES DE FIN" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="TALLERES" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding Periodos}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Aún no hay períodos. Crea uno para poder registrar talleres."
                                   Style="{StaticResource Subtitulo}" HorizontalOptions="Center" Margin="0,40" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,120,130" ColumnSpacing="16" Padding="20,0" HeightRequest="60">
                                    <Label Text="{Binding MesInicio}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding MesFin}" FontSize="16" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding CantidadTalleres}" VerticalOptions="Center" />
                                    <Button Grid.Column="3" Text="Editar" Style="{StaticResource BotonSecundario}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarPeriodoCommand}" CommandParameter="{Binding .}"
                                            VerticalOptions="Center" />
                                    <BoxView Grid.ColumnSpan="4" HeightRequest="1" Color="{StaticResource Linea}"
                                             VerticalOptions="End" Margin="-20,0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primario}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</ContentPage>
