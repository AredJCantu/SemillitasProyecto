<?xml version="1.0" encoding="utf-8" ?>
<!--
    Menú lateral de Windows. Cada vista lo incluye con <wViews:MenuLateral Activo="Cobranza" />.
    Cada opción ejecuta NavegarCommand con la ruta de AppShell como parámetro.
    Usuario y rol van fijos ("Rocío" / "Recepción") hasta tener sesión.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SemillitasMobileApp.Viewmodels"
             x:Class="SemillitasMobileApp.Views.WindowsViews.MenuLateral"
             x:Name="Menu">

    <!-- ViewModel del menú, creado desde el XAML -->
    <ContentView.BindingContext>
        <vm:MenuLateralViewModel />
    </ContentView.BindingContext>

    <ContentView.Resources>
        <Color x:Key="PrimarioOscuro">#1F3A2E</Color>
        <Color x:Key="ItemActivo">#2F5A45</Color>
        <Color x:Key="TextoClaro">#E8EFE9</Color>
        <Color x:Key="TextoApagado">#9DB5A6</Color>

        <!-- Opción del menú (se ilumina si Activo coincide) -->
        <Style x:Key="Opcion" TargetType="Border">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="10" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OpcionTexto" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextoClaro}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Grid WidthRequest="232" BackgroundColor="{StaticResource PrimarioOscuro}"
          RowDefinitions="Auto,*,Auto" Padding="16,24" RowSpacing="28">

        <!-- Logo -->
        <VerticalStackLayout Spacing="2">
            <Label Text="Semillitas" FontSize="22" FontAttributes="Bold" TextColor="White" />
            <Label Text="Gestión de talleres" FontSize="13" TextColor="{StaticResource TextoApagado}" />
        </VerticalStackLayout>

        <!-- Opciones -->
        <VerticalStackLayout Grid.Row="1" Spacing="4">

            <Border Style="{StaticResource Opcion}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Menu}, Path=Activo}" Value="Disponibilidad">
                        <Setter Property="BackgroundColor" Value="{StaticResource ItemActivo}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavegarCommand}"
                                          CommandParameter="MainView" />
                </Border.GestureRecognizers>
                <Label Text="Disponibilidad" Style="{StaticResource OpcionTexto}" />
            </Border>

            <Border Style="{StaticResource Opcion}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Menu}, Path=Activo}" Value="Inscribir">
                        <Setter Property="BackgroundColor" Value="{StaticResource ItemActivo}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavegarCommand}"
                                          CommandParameter="InscripcionView" />
                </Border.GestureRecognizers>
                <Label Text="Inscribir" Style="{StaticResource OpcionTexto}" />
            </Border>

            <Border Style="{StaticResource Opcion}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Menu}, Path=Activo}" Value="Cobranza">
                        <Setter Property="BackgroundColor" Value="{StaticResource ItemActivo}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavegarCommand}"
                                          CommandParameter="CobranzaView" />
                </Border.GestureRecognizers>
                <Label Text="Cobranza" Style="{StaticResource OpcionTexto}" />
            </Border>

            <Border Style="{StaticResource Opcion}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Menu}, Path=Activo}" Value="Agenda">
                        <Setter Property="BackgroundColor" Value="{StaticResource ItemActivo}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavegarCommand}"
                                          CommandParameter="AgendaView" />
                </Border.GestureRecognizers>
                <Label Text="Agenda" Style="{StaticResource OpcionTexto}" />
            </Border>

            <Border Style="{StaticResource Opcion}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Menu}, Path=Activo}" Value="Alumnos">
                        <Setter Property="BackgroundColor" Value="{StaticResource ItemActivo}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavegarCommand}"
                                          CommandParameter="AlumnosView" />
                </Border.GestureRecognizers>
                <Label Text="Alumnos" Style="{StaticResource OpcionTexto}" />
            </Border>

            <Border Style="{StaticResource Opcion}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Menu}, Path=Activo}" Value="Talleres">
                        <Setter Property="BackgroundColor" Value="{StaticResource ItemActivo}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavegarCommand}"
                                          CommandParameter="TalleresView" />
                </Border.GestureRecognizers>
                <Label Text="Talleres" Style="{StaticResource OpcionTexto}" />
            </Border>

            <Border Style="{StaticResource Opcion}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Menu}, Path=Activo}" Value="Periodos">
                        <Setter Property="BackgroundColor" Value="{StaticResource ItemActivo}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavegarCommand}"
                                          CommandParameter="PeriodosView" />
                </Border.GestureRecognizers>
                <Label Text="Períodos" Style="{StaticResource OpcionTexto}" />
            </Border>

        </VerticalStackLayout>

        <!-- Usuario -->
        <HorizontalStackLayout Grid.Row="2" Spacing="12">
            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" BackgroundColor="#2A6F4F"
                    StrokeShape="RoundRectangle 20">
                <Label Text="R" FontAttributes="Bold" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Rocío" FontAttributes="Bold" TextColor="White" />
                <Label Text="Recepción" FontSize="13" TextColor="{StaticResource TextoApagado}" />
            </VerticalStackLayout>
        </HorizontalStackLayout>
    </Grid>
</ContentView>
