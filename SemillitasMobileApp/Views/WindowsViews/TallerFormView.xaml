<?xml version="1.0" encoding="utf-8" ?>
<!--
    Crear / editar taller (mismo formulario; EsEdicion muestra Eliminar).
    Lee (TwoWay): Titulo, EsEdicion, Nombre, Categorias, CategoriaSeleccionada, NombreInstructor,
         Periodos, PeriodoSeleccionado, CupoMaximo, Costo, Horas, HoraInicio, HoraFin, IsBusy,
         TieneErrorNombre/ErrorNombre, TieneErrorCosto/ErrorCosto
    Horas = lista de horas ("3:00 pm"); el DTO guarda enteros (15 = 3 pm).
    Los mensajes de error vienen de los validators de la API; copia el patrón de Nombre/Costo.
    Commands: CancelarCommand, GuardarCommand, EliminarCommand
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:vm="clr-namespace:SemillitasMobileApp.Viewmodels"
             xmlns:b="clr-namespace:SemillitasMobileApp.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:wViews="clr-namespace:SemillitasMobileApp.Views.WindowsViews"
             x:Class="SemillitasMobileApp.Views.WindowsViews.TallerFormView"
             Title="Taller">

    <ContentPage.BindingContext>
        <vm:TallerFormViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Behaviors>
        <b:AlAparecerBehavior Command="{Binding CargarCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Color x:Key="Fondo">#F7F5EF</Color>
        <Color x:Key="Blanco">#FFFFFF</Color>
        <Color x:Key="Tinta">#1F2A24</Color>
        <Color x:Key="TintaSuave">#5A655E</Color>
        <Color x:Key="Linea">#E2DED2</Color>
        <Color x:Key="BordeCampo">#CFCABB</Color>
        <Color x:Key="Primario">#2A6F4F</Color>
        <Color x:Key="RojoTexto">#8E2A17</Color>

        <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta}" /></Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
        <Style TargetType="TimePicker">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
        </Style>

        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Error" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
        </Style>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource Linea}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="Padding" Value="24,0" />
        </Style>
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="BorderColor" Value="{StaticResource BordeCampo}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="Padding" Value="24,0" />
        </Style>
        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
            <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
        </Style>
    </ContentPage.Resources>

    <!-- Menú (232) + contenido -->
    <Grid ColumnDefinitions="232,*">
        <wViews:MenuLateral Activo="Talleres" />
        <Grid Grid.Column="1">
        <ScrollView BackgroundColor="{StaticResource Fondo}">
            <VerticalStackLayout Spacing="20" Padding="32,24" MaximumWidthRequest="900" HorizontalOptions="Start">

                <!-- Encabezado -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Titulo}" Style="{StaticResource Titulo}" />
                    <Button Grid.Column="1" Text="Cancelar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding CancelarCommand}" />
                </Grid>

                <!-- Formulario (2 columnas) -->
                <Border Style="{StaticResource Tarjeta}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24" RowSpacing="18"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                        <!-- Nombre (ocupa las 2 columnas) -->
                        <VerticalStackLayout Grid.ColumnSpan="2" Spacing="6">
                            <Label Text="Nombre del taller" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Nombre}" Placeholder="Ej. Futbol infantil" />
                            <Label Text="{Binding ErrorNombre}" Style="{StaticResource Error}"
                                   IsVisible="{Binding TieneErrorNombre}" />
                        </VerticalStackLayout>

                        <!-- Categoría (lista fija: Arte, Deportes, Tecnología) / Instructor (texto libre) -->
                        <VerticalStackLayout Grid.Row="1" Spacing="6">
                            <Label Text="Categoría" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Categorias}"
                                    SelectedItem="{Binding CategoriaSeleccionada}" Title="Elige una categoría" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                            <Label Text="Instructor" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding NombreInstructor}" Placeholder="Ej. Prof. Laura Méndez" />
                        </VerticalStackLayout>

                        <!-- Período al que pertenece el taller / Cupo -->
                        <VerticalStackLayout Grid.Row="2" Spacing="6">
                            <Label Text="Período" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Periodos}"
                                    SelectedItem="{Binding PeriodoSeleccionado}" Title="Elige un período" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="6">
                            <Label Text="Cupo máximo" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding CupoMaximo}" Keyboard="Numeric" />
                        </VerticalStackLayout>

                        <!-- Horario: la base guarda horas enteras (15 = 3 pm), por eso listas y no TimePicker -->
                        <VerticalStackLayout Grid.Row="3" Spacing="6">
                            <Label Text="Hora de inicio" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Horas}" SelectedItem="{Binding HoraInicio}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="6">
                            <Label Text="Hora de fin" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Horas}" SelectedItem="{Binding HoraFin}" />
                        </VerticalStackLayout>

                        <!-- Costo (máximo 999.99 en la base) -->
                        <VerticalStackLayout Grid.Row="4" Spacing="6">
                            <Label Text="Costo ($)" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Costo}" Keyboard="Numeric" />
                            <Label Text="{Binding ErrorCosto}" Style="{StaticResource Error}"
                                   IsVisible="{Binding TieneErrorCosto}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Pie de acciones -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Text="Eliminar taller" Style="{StaticResource BotonPeligro}"
                            Command="{Binding EliminarCommand}" IsVisible="{Binding EsEdicion}" />

                    <HorizontalStackLayout Grid.Column="2" Spacing="12">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Primario}" VerticalOptions="Center" />
                        <Button Text="Guardar taller" Style="{StaticResource BotonPrimario}" Command="{Binding GuardarCommand}" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
