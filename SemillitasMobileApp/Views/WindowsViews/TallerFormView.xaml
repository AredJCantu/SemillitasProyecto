<?xml version="1.0" encoding="utf-8" ?>
<!--
    ╔══════════════════════════════════════════════════════════════════════╗
    ║  WINDOWS · TALLERFORMVIEW — Crear / editar un taller                  ║
    ╚══════════════════════════════════════════════════════════════════════╝

    PARA QUÉ SIRVE:
      Un solo formulario para "Nuevo taller" y "Editar taller". La propiedad
      EsEdicion decide si se muestra el botón de desactivar.

    ESTRUCTURA:
      1) Encabezado (Titulo viene del VM) + Cancelar
      2) Tarjeta del formulario en 2 columnas:
           Nombre · Categoría · Instructor · Días · Hora inicio/fin · Cupo · Costo
      3) Pie con Guardar (y Desactivar si EsEdicion)

    VALIDACIÓN:
      Las reglas (costo > 0, hora fin > inicio, etc.) viven en los VALIDATORS de
      tu compañero. La vista solo muestra el mensaje que ellos devuelvan:
      cada campo tiene un Label de error visible según una propiedad bool
      (TieneErrorNombre, TieneErrorCosto...) con su texto (ErrorNombre, ErrorCosto...).
      Aquí vienen cableados Nombre y Costo; copia el patrón para los demás.

    PROPIEDADES QUE LEE DEL BindingContext (TwoWay en los campos):
      Titulo, EsEdicion,
      Nombre, Categorias, CategoriaSeleccionada, Instructores, InstructorSeleccionado,
      Dias (cada uno: Texto, Seleccionado bool), HoraInicio (TimeSpan), HoraFin (TimeSpan),
      CupoMaximo, CostoMensual,
      TieneErrorNombre/ErrorNombre, TieneErrorCosto/ErrorCosto, IsBusy.

    COMMANDS POR AGREGAR ("TODO COMMAND"):
      Cancelar · Guardar · Desactivar
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:wViews="clr-namespace:SemillitasMobileApp.Views.WindowsViews"
             x:Class="SemillitasMobileApp.Views.WindowsViews.TallerFormView"
             Title="Taller">

    <ContentPage.Resources>
        <Color x:Key="Fondo">#F7F5EF</Color>
        <Color x:Key="Blanco">#FFFFFF</Color>
        <Color x:Key="Tinta">#1F2A24</Color>
        <Color x:Key="TintaSuave">#5A655E</Color>
        <Color x:Key="Linea">#E2DED2</Color>
        <Color x:Key="BordeCampo">#CFCABB</Color>
        <Color x:Key="Primario">#2A6F4F</Color>
        <Color x:Key="RojoTexto">#8E2A17</Color>

        <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta}" /></Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
        <Style TargetType="TimePicker">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
        </Style>

        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Error" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
        </Style>
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource Linea}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="Padding" Value="24,0" />
        </Style>
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="BorderColor" Value="{StaticResource BordeCampo}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="Padding" Value="24,0" />
        </Style>
        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
            <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
        </Style>
    </ContentPage.Resources>

    <!-- Barra lateral a la izquierda (232) + contenido de la página a la derecha (*) -->
    <Grid ColumnDefinitions="232,*">
        <wViews:MenuLateral Activo="Catalogos" />
        <Grid Grid.Column="1">
        <ScrollView BackgroundColor="{StaticResource Fondo}">
            <VerticalStackLayout Spacing="20" Padding="32,24" MaximumWidthRequest="900" HorizontalOptions="Start">

                <!-- ═══════════ 1 · ENCABEZADO ═══════════ -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Titulo}" Style="{StaticResource Titulo}" />
                    <!-- TODO COMMAND: CancelarCommand — vuelve a TalleresView sin guardar. -->
                    <Button Grid.Column="1" Text="Cancelar" Style="{StaticResource BotonSecundario}" />
                </Grid>

                <!-- ═══════════ 2 · FORMULARIO (2 columnas) ═══════════ -->
                <Border Style="{StaticResource Tarjeta}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24" RowSpacing="18"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                        <!-- Nombre (ocupa las 2 columnas) -->
                        <VerticalStackLayout Grid.ColumnSpan="2" Spacing="6">
                            <Label Text="Nombre del taller" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding Nombre}" Placeholder="Ej. Futbol infantil" />
                            <Label Text="{Binding ErrorNombre}" Style="{StaticResource Error}"
                                   IsVisible="{Binding TieneErrorNombre}" />
                        </VerticalStackLayout>

                        <!-- Categoría / Instructor -->
                        <VerticalStackLayout Grid.Row="1" Spacing="6">
                            <Label Text="Categoría" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Categorias}"
                                    SelectedItem="{Binding CategoriaSeleccionada}" Title="Elige una categoría" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                            <Label Text="Instructor" Style="{StaticResource Etiqueta}" />
                            <Picker ItemsSource="{Binding Instructores}"
                                    SelectedItem="{Binding InstructorSeleccionado}" Title="Elige un instructor" />
                        </VerticalStackLayout>

                        <!-- Días: casillas generadas desde la lista Dias -->
                        <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="6">
                            <Label Text="Días en que se imparte" Style="{StaticResource Etiqueta}" />
                            <HorizontalStackLayout Spacing="20" BindableLayout.ItemsSource="{Binding Dias}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <HorizontalStackLayout Spacing="4">
                                            <CheckBox IsChecked="{Binding Seleccionado}" Color="{StaticResource Primario}" />
                                            <Label Text="{Binding Texto}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Horas -->
                        <VerticalStackLayout Grid.Row="3" Spacing="6">
                            <Label Text="Hora de inicio" Style="{StaticResource Etiqueta}" />
                            <TimePicker Time="{Binding HoraInicio}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="6">
                            <Label Text="Hora de fin" Style="{StaticResource Etiqueta}" />
                            <TimePicker Time="{Binding HoraFin}" />
                        </VerticalStackLayout>

                        <!-- Cupo / Costo -->
                        <VerticalStackLayout Grid.Row="4" Spacing="6">
                            <Label Text="Cupo máximo" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding CupoMaximo}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="4" Grid.Column="1" Spacing="6">
                            <Label Text="Costo mensual ($)" Style="{StaticResource Etiqueta}" />
                            <Entry Text="{Binding CostoMensual}" Keyboard="Numeric" />
                            <!-- El mensaje viene del validator; la vista solo lo muestra. -->
                            <Label Text="{Binding ErrorCosto}" Style="{StaticResource Error}"
                                   IsVisible="{Binding TieneErrorCosto}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ═══════════ 3 · PIE DE ACCIONES ═══════════ -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- TODO COMMAND: DesactivarCommand
                         Solo visible al editar (EsEdicion = true). Confirmar con DisplayAlert antes de llamar a la API. -->
                    <Button Text="Desactivar taller" Style="{StaticResource BotonPeligro}"
                            IsVisible="{Binding EsEdicion}" />

                    <HorizontalStackLayout Grid.Column="2" Spacing="12">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Primario}" VerticalOptions="Center" />
                        <!-- TODO COMMAND: GuardarCommand
                             Qué hace: manda el DTO a la API (crear o actualizar según EsEdicion).
                             Si la API/validators devuelven errores, el VM llena Error* y Tiene* y la vista los muestra. -->
                        <Button Text="Guardar taller" Style="{StaticResource BotonPrimario}" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
