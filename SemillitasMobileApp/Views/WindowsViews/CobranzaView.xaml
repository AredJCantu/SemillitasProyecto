<?xml version="1.0" encoding="utf-8" ?>
<!--
    Cobranza: inscripciones con adeudo (Inscripciones.Debe) y botón para marcarlas pagadas.
    Lee: Periodos, PeriodoSeleccionado, Cobrado, PorCobrar, AlumnosConAdeudo (montos ya formateados),
         Filtros[Texto], FiltroSeleccionado, TextoBusqueda, IsBusy,
         Cobros[Tutor, Alumno, Taller, Costo, Estado, Tono, PuedeMarcarPago]
    Estado = Debe | Al corriente; Tono = Rojo | Verde
    Commands: MarcarPagadoCommand (fila)
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:vm="clr-namespace:SemillitasMobileApp.Viewmodels"
             xmlns:b="clr-namespace:SemillitasMobileApp.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:wViews="clr-namespace:SemillitasMobileApp.Views.WindowsViews"
             x:Class="SemillitasMobileApp.Views.WindowsViews.CobranzaView"
             Title="Cobranza">

    <ContentPage.BindingContext>
        <vm:CobranzaViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Behaviors>
        <b:AlAparecerBehavior Command="{Binding CargarCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Color x:Key="Fondo">#F7F5EF</Color>
        <Color x:Key="Blanco">#FFFFFF</Color>
        <Color x:Key="Tinta">#1F2A24</Color>
        <Color x:Key="TintaSuave">#5A655E</Color>
        <Color x:Key="Linea">#E2DED2</Color>
        <Color x:Key="BordeCampo">#CFCABB</Color>
        <Color x:Key="Primario">#2A6F4F</Color>
        <Color x:Key="VerdeFondo">#DDEFE4</Color>
        <Color x:Key="VerdeTexto">#1E5A3D</Color>
        <Color x:Key="RojoFondo">#F6D9D2</Color>
        <Color x:Key="RojoTexto">#8E2A17</Color>
        <Color x:Key="RojoBarra">#B23A24</Color>

        <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta}" /></Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
        <Style TargetType="SearchBar">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>

        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Subtitulo" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Nota" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource Linea}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource BordeCampo}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="22" /></Setter.Value></Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
                                <Setter Property="Stroke" Value="{StaticResource Primario}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="15" /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="BackgroundColor" Value="{StaticResource RojoFondo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeTexto" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource VerdeTexto}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <!-- Menú (232) + contenido -->
    <Grid ColumnDefinitions="232,*">
        <wViews:MenuLateral Activo="Cobranza" />
        <Grid Grid.Column="1">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16" Padding="32,24"
              BackgroundColor="{StaticResource Fondo}">

            <!-- Encabezado -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Cobranza" Style="{StaticResource Titulo}" />
                    <Label Text="Inscripciones con adeudo y al corriente del período seleccionado."
                           Style="{StaticResource Subtitulo}" />
                </VerticalStackLayout>
                <Picker Grid.Column="1" ItemsSource="{Binding Periodos}"
                        SelectedItem="{Binding PeriodoSeleccionado}"
                        Title="Período" WidthRequest="190" VerticalOptions="End" />
            </Grid>

            <!-- Totales (3 tarjetas iguales) -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <Border Style="{StaticResource Tarjeta}" Padding="20,16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Cobrado" Style="{StaticResource Etiqueta}" TextColor="{StaticResource TintaSuave}" />
                        <Label Text="{Binding Cobrado}" FontSize="30" FontAttributes="Bold"
                               TextColor="{StaticResource VerdeTexto}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="20,16"
                        BackgroundColor="{StaticResource RojoFondo}" Stroke="{StaticResource RojoBarra}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Por cobrar" Style="{StaticResource Etiqueta}" TextColor="{StaticResource RojoTexto}" />
                        <Label Text="{Binding PorCobrar}" FontSize="30" FontAttributes="Bold"
                               TextColor="{StaticResource RojoTexto}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="20,16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Alumnos con adeudo" Style="{StaticResource Etiqueta}" TextColor="{StaticResource TintaSuave}" />
                        <Label Text="{Binding AlumnosConAdeudo}" FontSize="30" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Filtros -->
            <Grid Grid.Row="2" ColumnDefinitions="*,300" ColumnSpacing="16">
                <CollectionView ItemsSource="{Binding Filtros}" SelectionMode="Single"
                                SelectedItem="{Binding FiltroSeleccionado}" HeightRequest="52">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Chip}">
                                <Label Text="{Binding Texto}" FontAttributes="Bold" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <SearchBar Grid.Column="1" Text="{Binding TextoBusqueda}" Placeholder="Buscar tutor, alumno o taller"
                           VerticalOptions="Start" />
            </Grid>

            <!-- Tabla -->
            <Border Grid.Row="3" Style="{StaticResource Tarjeta}" Padding="0">
                <Grid RowDefinitions="Auto,*">

                    <Grid ColumnDefinitions="1.4*,1.3*,1.6*,90,130,156" ColumnSpacing="16"
                          Padding="20,0" HeightRequest="40" BackgroundColor="{StaticResource Fondo}">
                        <Label Text="TUTOR" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="ALUMNO" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="TALLER" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="COSTO" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="4" Text="ESTADO" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding Cobros}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No hay inscripciones con estos filtros." Style="{StaticResource Subtitulo}"
                                   HorizontalOptions="Center" Margin="0,40" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="1.4*,1.3*,1.6*,90,130,156" ColumnSpacing="16"
                                      Padding="20,0" HeightRequest="60">

                                    <Label Text="{Binding Tutor}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Alumno}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Taller}" Style="{StaticResource Nota}" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding Costo}" FontAttributes="Bold" VerticalOptions="Center" />

                                    <Border Grid.Column="4" Style="{StaticResource BadgeBorder}">
                                        <Label Text="{Binding Estado}" Style="{StaticResource BadgeTexto}" />
                                    </Border>

                                    <Button Grid.Column="5" Text="Marcar pagado" Style="{StaticResource BotonPrimario}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarcarPagadoCommand}" CommandParameter="{Binding .}"
                                            VerticalOptions="Center" IsVisible="{Binding PuedeMarcarPago}" />

                                    <BoxView Grid.ColumnSpan="6" HeightRequest="1" Color="{StaticResource Linea}"
                                             VerticalOptions="End" Margin="-20,0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primario}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</ContentPage>
