<?xml version="1.0" encoding="utf-8" ?>
<!--
    Inscribir a un alumno en talleres (alumno nuevo o existente, todo en una página).
    Lee: SubtituloInscripcion, Periodo, Total, HayError, MensajeError, TextoBusquedaAlumno,
         NombreAlumno, ApellidoAlumno, NombreTutor, ApellidoTutor, TelefonoAlumno (TwoWay),
         Talleres[Nombre, Horario, Costo, Badge, Tono, Accion], Resumen[Nombre, Horario, Precio]
    Accion la decide la API: Disponible | Agregado | Choque | Lleno
    Commands: CancelarCommand, AlternarTallerCommand (fila), QuitarDelResumenCommand (fila),
              ConfirmarInscripcionCommand
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:vm="clr-namespace:SemillitasMobileApp.Viewmodels"
             xmlns:b="clr-namespace:SemillitasMobileApp.Behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:wViews="clr-namespace:SemillitasMobileApp.Views.WindowsViews"
             x:Class="SemillitasMobileApp.Views.WindowsViews.InscripcionView"
             Title="Nueva inscripción">

    <ContentPage.BindingContext>
        <vm:InscripcionViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Behaviors>
        <b:AlAparecerBehavior Command="{Binding CargarCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Color x:Key="Fondo">#F7F5EF</Color>
        <Color x:Key="Blanco">#FFFFFF</Color>
        <Color x:Key="Tinta">#1F2A24</Color>
        <Color x:Key="TintaSuave">#5A655E</Color>
        <Color x:Key="Linea">#E2DED2</Color>
        <Color x:Key="BordeCampo">#CFCABB</Color>
        <Color x:Key="Deshabilitado">#EFECE2</Color>
        <Color x:Key="Primario">#2A6F4F</Color>
        <Color x:Key="VerdeFondo">#DDEFE4</Color>
        <Color x:Key="VerdeTexto">#1E5A3D</Color>
        <Color x:Key="AmbarFondo">#FBEBC4</Color>
        <Color x:Key="AmbarTexto">#7A4B00</Color>
        <Color x:Key="RojoFondo">#F6D9D2</Color>
        <Color x:Key="RojoTexto">#8E2A17</Color>
        <Color x:Key="RojoBarra">#B23A24</Color>

        <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta}" /></Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
        <Style TargetType="SearchBar">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>

        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Subtitulo" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Seccion" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
        <Style x:Key="Nota" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>

        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource Linea}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        </Style>

        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="18,0" />
        </Style>
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="BorderColor" Value="{StaticResource BordeCampo}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="18,0" />
        </Style>

        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="15" /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding Tono}" Value="Ambar">
                    <Setter Property="BackgroundColor" Value="{StaticResource AmbarFondo}" />
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="BackgroundColor" Value="{StaticResource RojoFondo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeTexto" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource VerdeTexto}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="Ambar">
                    <Setter Property="TextColor" Value="{StaticResource AmbarTexto}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <!-- Menú (232) + contenido -->
    <Grid ColumnDefinitions="232,*">
        <wViews:MenuLateral Activo="Inscribir" />
        <Grid Grid.Column="1">
        <ScrollView BackgroundColor="{StaticResource Fondo}">
            <VerticalStackLayout Spacing="16" Padding="32,24">

                <!-- Encabezado -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nueva inscripción" Style="{StaticResource Titulo}" />
                        <Label Text="{Binding SubtituloInscripcion}" Style="{StaticResource Subtitulo}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="Cancelar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding CancelarCommand}" VerticalOptions="End" />
                </Grid>

                <!-- Zona principal: izquierda (*) y derecha (340 fijo) -->
                <Grid ColumnDefinitions="*,340" ColumnSpacing="24">

                    <!-- Izquierda -->
                    <VerticalStackLayout Spacing="16" VerticalOptions="Start">

                        <!-- Alumno: buscar uno existente o llenar los datos -->
                        <Border Style="{StaticResource Tarjeta}" Padding="20">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="Alumno" Style="{StaticResource Seccion}" />

                                <SearchBar Text="{Binding TextoBusquedaAlumno}"
                                           Placeholder="Buscar alumno ya registrado (opcional)" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Nombre" Style="{StaticResource Etiqueta}" />
                                        <Entry Text="{Binding NombreAlumno}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="Apellidos" Style="{StaticResource Etiqueta}" />
                                        <Entry Text="{Binding ApellidoAlumno}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Spacing="6">
                                        <Label Text="Nombre del tutor" Style="{StaticResource Etiqueta}" />
                                        <Entry Text="{Binding NombreTutor}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                        <Label Text="Apellidos del tutor" Style="{StaticResource Etiqueta}" />
                                        <Entry Text="{Binding ApellidoTutor}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="2" Spacing="6">
                                        <Label Text="Teléfono" Style="{StaticResource Etiqueta}" />
                                        <Entry Text="{Binding TelefonoAlumno}" Keyboard="Telephone" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- TARJETA TALLERES -->
                        <Border Style="{StaticResource Tarjeta}" Padding="0">
                            <VerticalStackLayout>
                                <Grid Padding="20,16">
                                    <Label Text="{Binding Periodo, StringFormat='Talleres del período {0}'}"
                                           Style="{StaticResource Seccion}" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="{StaticResource Linea}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Talleres}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto,132" ColumnSpacing="14" Padding="20,12">

                                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" />
                                                    <Label Text="{Binding Horario}" Style="{StaticResource Nota}" />
                                                </VerticalStackLayout>

                                                <Label Grid.Column="1" Text="{Binding Costo}" FontAttributes="Bold"
                                                       VerticalOptions="Center" />

                                                <Border Grid.Column="2" Style="{StaticResource BadgeBorder}">
                                                    <Label Text="{Binding Badge}" Style="{StaticResource BadgeTexto}" />
                                                </Border>

                                                <!-- 4 apariencias según Accion; los bloqueados usan InputTransparent para conservar el color -->
                                                <Button Grid.Column="3" Text="Agregar" Style="{StaticResource BotonPrimario}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AlternarTallerCommand}" CommandParameter="{Binding .}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding Accion}" Value="Agregado">
                                                            <Setter Property="Text" Value="Agregado" />
                                                            <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
                                                            <Setter Property="TextColor" Value="{StaticResource VerdeTexto}" />
                                                            <Setter Property="BorderColor" Value="{StaticResource Primario}" />
                                                            <Setter Property="BorderWidth" Value="1" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Button" Binding="{Binding Accion}" Value="Choque">
                                                            <Setter Property="Text" Value="Se solapa" />
                                                            <Setter Property="BackgroundColor" Value="{StaticResource RojoFondo}" />
                                                            <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
                                                            <Setter Property="BorderColor" Value="{StaticResource RojoBarra}" />
                                                            <Setter Property="BorderWidth" Value="1" />
                                                            <Setter Property="InputTransparent" Value="True" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Button" Binding="{Binding Accion}" Value="Lleno">
                                                            <Setter Property="Text" Value="Sin cupo" />
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Deshabilitado}" />
                                                            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
                                                            <Setter Property="InputTransparent" Value="True" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>

                                                <BoxView Grid.ColumnSpan="4" HeightRequest="1" Color="{StaticResource Linea}"
                                                         VerticalOptions="End" Margin="-20,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Derecha: error y resumen -->
                    <VerticalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Start">

                        <!-- Banner de error: visible solo si HayError = true. El TEXTO lo manda la API. -->
                        <Border IsVisible="{Binding HayError}" Padding="14,12"
                                BackgroundColor="{StaticResource RojoFondo}"
                                Stroke="{StaticResource RojoBarra}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 14">
                            <Label Text="{Binding MensajeError}" TextColor="{StaticResource RojoTexto}"
                                   FontSize="14" FontAttributes="Bold" />
                        </Border>

                        <Border Style="{StaticResource Tarjeta}" Padding="20,18">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Resumen" Style="{StaticResource Seccion}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Resumen}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,44" ColumnSpacing="6" Padding="0,6">
                                                <VerticalStackLayout>
                                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                                    <Label Text="{Binding Horario}" Style="{StaticResource Nota}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding Precio}" FontAttributes="Bold"
                                                       VerticalOptions="Center" />
                                                <Button Grid.Column="2" Text="✕" BackgroundColor="Transparent"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.QuitarDelResumenCommand}" CommandParameter="{Binding .}"
                                                        TextColor="{StaticResource TintaSuave}"
                                                        WidthRequest="44" HeightRequest="44" Padding="0" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <BoxView HeightRequest="1" Color="{StaticResource Linea}" />

                                <!-- El total llega YA calculado: la vista no suma nada. -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Total" Style="{StaticResource Etiqueta}" VerticalOptions="End" />
                                    <Label Grid.Column="1" Text="{Binding Total}" FontSize="30" FontAttributes="Bold" />
                                </Grid>

                                <Button Text="Confirmar inscripción" Style="{StaticResource BotonPrimario}"
                                        Command="{Binding ConfirmarInscripcionCommand}" HeightRequest="48" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
