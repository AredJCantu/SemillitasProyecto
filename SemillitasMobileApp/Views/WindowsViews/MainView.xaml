<?xml version="1.0" encoding="utf-8" ?>
<!--
    ╔══════════════════════════════════════════════════════════════════════╗
    ║  WINDOWS · MAINVIEW — Disponibilidad de talleres (pantalla principal) ║
    ╚══════════════════════════════════════════════════════════════════════╝

    PARA QUÉ SIRVE:
      Que la recepcionista responda "¿hay lugar?" en segundos.

    ESTRUCTURA (arriba → abajo):
      Fila 0  Encabezado: título + selector de período + botón "Nueva inscripción"
      Fila 1  Filtros: búsqueda, "Solo con cupo", contadores de colores
      Fila 2  Chips de categoría
      Fila 3  Tabla de talleres (una fila por taller, con barra de cupo)
      Fila 4  Pie: "Mostrando X de Y" + paginación

    PROPIEDADES QUE ESTA VISTA LEE DEL BindingContext (nombres exactos):
      Periodos, PeriodoSeleccionado, TextoBusqueda, SoloConCupo,
      Categorias (cada una con Texto), CategoriaSeleccionada,
      ConteoConCupo, ConteoPocos, ConteoLlenos,
      Talleres (cada uno con: Nombre, Meta, Horario, Ocupacion, Porcentaje,
               Badge, Tono, TieneCupo),
      IsBusy, ResumenListado.
      · Porcentaje va de 0 a 1 (9/15 = 0.6).
      · Tono es el texto "Verde", "Ambar" o "Rojo".

    COMMANDS POR AGREGAR (busca "TODO COMMAND"):
      Nueva inscripción · Inscribir (cada fila) · Anterior / Siguiente

    NOTA: esta vista no usa x:DataType, así que no depende de ningún
    ViewModel concreto: solo de los NOMBRES de propiedad de arriba.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:wViews="clr-namespace:SemillitasMobileApp.Views.WindowsViews"
             x:Class="SemillitasMobileApp.Views.WindowsViews.MainView"
             Title="Disponibilidad">

    <ContentPage.Resources>
        <!-- ══ COLORES: cambia aquí y se actualiza toda la vista ══ -->
        <Color x:Key="Fondo">#F7F5EF</Color>
        <Color x:Key="Blanco">#FFFFFF</Color>
        <Color x:Key="Tinta">#1F2A24</Color>
        <Color x:Key="TintaSuave">#5A655E</Color>
        <Color x:Key="Linea">#E2DED2</Color>
        <Color x:Key="BordeCampo">#CFCABB</Color>
        <Color x:Key="Deshabilitado">#EFECE2</Color>
        <Color x:Key="Primario">#2A6F4F</Color>
        <Color x:Key="PrimarioOscuro">#1F3A2E</Color>
        <Color x:Key="VerdeFondo">#DDEFE4</Color>
        <Color x:Key="VerdeTexto">#1E5A3D</Color>
        <Color x:Key="VerdeBarra">#2A6F4F</Color>
        <Color x:Key="AmbarFondo">#FBEBC4</Color>
        <Color x:Key="AmbarTexto">#7A4B00</Color>
        <Color x:Key="AmbarBarra">#B7791F</Color>
        <Color x:Key="RojoFondo">#F6D9D2</Color>
        <Color x:Key="RojoTexto">#8E2A17</Color>
        <Color x:Key="RojoBarra">#B23A24</Color>

        <!-- ══ ESTILOS IMPLÍCITOS (se aplican solos) ══ -->
        <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta}" /></Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>
        <Style TargetType="SearchBar">
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>

        <!-- ══ ESTILOS CON NOMBRE (se piden con Style="{StaticResource ...}") ══ -->
        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
        </Style>
        <Style x:Key="Subtitulo" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
        </Style>
        <Style x:Key="Nota" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
        </Style>

        <!-- Tarjeta: contenedor blanco redondeado -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource Linea}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="16" /></Setter.Value></Setter>
        </Style>

        <!-- Chip: filtro tipo píldora; se ilumina cuando está seleccionado -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="Stroke" Value="{StaticResource BordeCampo}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="22" /></Setter.Value></Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
                                <Setter Property="Stroke" Value="{StaticResource Primario}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="18,0" />
        </Style>
        <Style x:Key="BotonSecundario" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
            <Setter Property="TextColor" Value="{StaticResource Tinta}" />
            <Setter Property="BorderColor" Value="{StaticResource BordeCampo}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="Padding" Value="18,0" />
        </Style>

        <!-- BadgeBorder + BadgeTexto: la "píldora" de estado ("Quedan 6", "Lleno").
             Cambian de color según la propiedad Tono del elemento (Verde/Ambar/Rojo).
             Se usan juntos: un Border con BadgeBorder que contiene un Label con BadgeTexto. -->
        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="{StaticResource VerdeFondo}" />
            <Setter Property="StrokeShape"><Setter.Value><RoundRectangle CornerRadius="15" /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding Tono}" Value="Ambar">
                    <Setter Property="BackgroundColor" Value="{StaticResource AmbarFondo}" />
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="BackgroundColor" Value="{StaticResource RojoFondo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeTexto" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource VerdeTexto}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="Ambar">
                    <Setter Property="TextColor" Value="{StaticResource AmbarTexto}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="TextColor" Value="{StaticResource RojoTexto}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- BarraProgreso: barra de cupo; su color también depende de Tono -->
        <Style x:Key="BarraProgreso" TargetType="ProgressBar">
            <Setter Property="ProgressColor" Value="{StaticResource VerdeBarra}" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Style.Triggers>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding Tono}" Value="Ambar">
                    <Setter Property="ProgressColor" Value="{StaticResource AmbarBarra}" />
                </DataTrigger>
                <DataTrigger TargetType="ProgressBar" Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="ProgressColor" Value="{StaticResource RojoBarra}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <!-- Barra lateral a la izquierda (232) + contenido de la página a la derecha (*) -->
    <Grid ColumnDefinitions="232,*">
        <wViews:MenuLateral Activo="Disponibilidad" />
        <Grid Grid.Column="1">
        <!-- El fondo se pone en este Grid raíz (y no en el ContentPage) para poder usar
             el color definido en los Resources de esta misma página. -->
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16" Padding="32,24"
              BackgroundColor="{StaticResource Fondo}">

            <!-- ═══════════ FILA 0 · ENCABEZADO ═══════════ -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Disponibilidad de talleres" Style="{StaticResource Titulo}" />
                    <Label Text="¿Hay lugar? Revisa el cupo de cada grupo del período."
                           Style="{StaticResource Subtitulo}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="End">
                    <!-- Selector de período. SelectedItem es TwoWay por defecto en Picker. -->
                    <Picker ItemsSource="{Binding Periodos}"
                            SelectedItem="{Binding PeriodoSeleccionado}"
                            Title="Período"
                            WidthRequest="170" />

                    <!-- TODO COMMAND: NuevaInscripcionCommand
                         Qué hace: abre la vista de inscripción (InscripcionView).
                         Cómo: Command="{Binding NuevaInscripcionCommand}" -->
                    <Button Text="+ Nueva inscripción" Style="{StaticResource BotonPrimario}" />
                </HorizontalStackLayout>
            </Grid>

            <!-- ═══════════ FILA 1 · FILTROS ═══════════ -->
            <Grid Grid.Row="1" ColumnDefinitions="320,Auto,*" ColumnSpacing="20">

                <!-- Búsqueda. TODO: al cambiar TextoBusqueda, la lista debe volver a filtrarse
                     (lo resuelve quien programe el ViewModel). -->
                <SearchBar Text="{Binding TextoBusqueda}" Placeholder="Buscar taller o instructor" />

                <!-- Casilla "Solo con cupo" → bool SoloConCupo -->
                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding SoloConCupo}" Color="{StaticResource Primario}" />
                    <Label Text="Solo con cupo" Style="{StaticResource Etiqueta}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Contadores de colores (cuántos talleres hay en cada estado) -->
                <HorizontalStackLayout Grid.Column="2" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">
                    <Border HeightRequest="30" Padding="12,0" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                            BackgroundColor="{StaticResource VerdeFondo}">
                        <Label Text="{Binding ConteoConCupo, StringFormat='{0} con cupo'}" FontSize="13"
                               FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource VerdeTexto}" />
                    </Border>
                    <Border HeightRequest="30" Padding="12,0" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                            BackgroundColor="{StaticResource AmbarFondo}">
                        <Label Text="{Binding ConteoPocos, StringFormat='{0} con pocos lugares'}" FontSize="13"
                               FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource AmbarTexto}" />
                    </Border>
                    <Border HeightRequest="30" Padding="12,0" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                            BackgroundColor="{StaticResource RojoFondo}">
                        <Label Text="{Binding ConteoLlenos, StringFormat='{0} lleno'}" FontSize="13"
                               FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource RojoTexto}" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ═══════════ FILA 2 · CHIPS DE CATEGORÍA ═══════════
                 Selección única; el chip seleccionado se pinta solo (estilo Chip). -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Categorias}"
                            SelectionMode="Single"
                            SelectedItem="{Binding CategoriaSeleccionada}"
                            HeightRequest="52">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Chip}">
                            <Label Text="{Binding Texto}" FontAttributes="Bold" VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ═══════════ FILA 3 · TABLA DE TALLERES ═══════════
                 Border con 2 renglones: encabezado fijo y lista con scroll.
                 Las 5 columnas de cada fila usan las MISMAS proporciones que el encabezado:
                 "2.2*,1.6*,2.2*,1.2*,120"  (si cambias una, cambia la otra). -->
            <Border Grid.Row="3" Style="{StaticResource Tarjeta}" Padding="0">
                <Grid RowDefinitions="Auto,*">

                    <Grid ColumnDefinitions="2.2*,1.6*,2.2*,1.2*,120" ColumnSpacing="16"
                          Padding="20,0" HeightRequest="40" BackgroundColor="{StaticResource Fondo}">
                        <Label Text="TALLER" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="HORARIO" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="INSCRITOS / CUPO" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="3" Text="ESTADO" Style="{StaticResource Nota}" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding Talleres}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="No hay talleres con estos filtros."
                                   Style="{StaticResource Subtitulo}"
                                   HorizontalOptions="Center" Margin="0,40" />
                        </CollectionView.EmptyView>

                        <!-- Plantilla de UNA fila. Aquí {Binding Nombre} se refiere al taller de esa fila. -->
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2.2*,1.6*,2.2*,1.2*,120" ColumnSpacing="16"
                                      Padding="20,0" HeightRequest="62">

                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding Meta}" Style="{StaticResource Nota}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="{Binding Horario}" FontAttributes="Bold"
                                           VerticalOptions="Center" />

                                    <!-- "9/15" + barra -->
                                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                        <Label Text="{Binding Ocupacion}" FontSize="16" FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <ProgressBar Grid.Column="1" Progress="{Binding Porcentaje}"
                                                     Style="{StaticResource BarraProgreso}" />
                                    </Grid>

                                    <!-- Píldora de estado -->
                                    <Border Grid.Column="3" Style="{StaticResource BadgeBorder}">
                                        <Label Text="{Binding Badge}" Style="{StaticResource BadgeTexto}" />
                                    </Border>

                                    <!-- TODO COMMAND: InscribirTallerCommand
                                         Qué hace: abre la inscripción con este taller ya elegido.
                                         Este botón está DENTRO de una plantilla, así que su contexto es
                                         el taller de la fila, no la vista. Para llegar al Command de la
                                         vista se usa RelativeSource, y se manda la fila como parámetro:
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                             Path=BindingContext.InscribirTallerCommand}"
                                           CommandParameter="{Binding .}"
                                         El trigger apaga el botón cuando TieneCupo = false.
                                         Es solo apariencia: la validación REAL la hace la API. -->
                                    <Button Grid.Column="4" Text="Inscribir" Style="{StaticResource BotonSecundario}"
                                            VerticalOptions="Center">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding TieneCupo}" Value="False">
                                                <Setter Property="Text" Value="Sin cupo" />
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource Deshabilitado}" />
                                                <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <BoxView Grid.ColumnSpan="5" HeightRequest="1" Color="{StaticResource Linea}"
                                             VerticalOptions="End" Margin="-20,0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Indicador de carga: solo visible mientras IsBusy = true -->
                    <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primario}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- ═══════════ FILA 4 · PIE ═══════════ -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                <Label Text="{Binding ResumenListado}" Style="{StaticResource Nota}" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <!-- TODO COMMAND: PaginaAnteriorCommand / PaginaSiguienteCommand
                         Qué hacen: pedir la página anterior/siguiente.
                         Idea: que CanExecute sea false en la primera/última página. -->
                    <Button Text="Anterior" Style="{StaticResource BotonSecundario}" />
                    <Button Text="Siguiente" Style="{StaticResource BotonSecundario}" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</ContentPage>
