<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Windows: una sección por opción del MenuLateral (el menú está dibujado en cada vista).
    Android: barra de pestañas inferior. IsVisible con OnPlatform muestra solo el grupo de cada plataforma.
    Las pantallas que se abren encima (formularios, detalle) se registran en AppShell.xaml.cs.
-->
<Shell
    x:Class="SemillitasMobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SemillitasMobileApp"
    xmlns:wViews="clr-namespace:SemillitasMobileApp.Views.WindowsViews"
    xmlns:aViews="clr-namespace:SemillitasMobileApp.Views.AndroidViews"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="SemillitasMobileApp">

    <!-- Windows -->
    <ShellContent
        Title="Disponibilidad"
        IsVisible="{OnPlatform WinUI=True, Default=False}"
        ContentTemplate="{DataTemplate wViews:MainView}"
        Route="MainView" />

    <ShellContent
        Title="Inscribir"
        IsVisible="{OnPlatform WinUI=True, Default=False}"
        ContentTemplate="{DataTemplate wViews:InscripcionView}"
        Route="InscripcionView" />

    <ShellContent
        Title="Cobranza"
        IsVisible="{OnPlatform WinUI=True, Default=False}"
        ContentTemplate="{DataTemplate wViews:CobranzaView}"
        Route="CobranzaView" />

    <ShellContent
        Title="Agenda"
        IsVisible="{OnPlatform WinUI=True, Default=False}"
        ContentTemplate="{DataTemplate wViews:AgendaView}"
        Route="AgendaView" />

    <ShellContent
        Title="Alumnos"
        IsVisible="{OnPlatform WinUI=True, Default=False}"
        ContentTemplate="{DataTemplate wViews:AlumnosView}"
        Route="AlumnosView" />

    <ShellContent
        Title="Talleres"
        IsVisible="{OnPlatform WinUI=True, Default=False}"
        ContentTemplate="{DataTemplate wViews:TalleresView}"
        Route="TalleresView" />

    <ShellContent
        Title="Períodos"
        IsVisible="{OnPlatform WinUI=True, Default=False}"
        ContentTemplate="{DataTemplate wViews:PeriodosView}"
        Route="PeriodosView" />

    <!-- Android -->
    <TabBar IsVisible="{OnPlatform Android=True, Default=False}">
        <ShellContent
            Title="Disponibilidad"
            ContentTemplate="{DataTemplate aViews:MainView}"
            Route="AndroidMainView" />

        <ShellContent
            Title="Cobranza"
            ContentTemplate="{DataTemplate aViews:CobranzaView}"
            Route="AndroidCobranzaView" />

        <ShellContent
            Title="Agenda"
            ContentTemplate="{DataTemplate aViews:AgendaView}"
            Route="AndroidAgendaView" />

        <ShellContent
            Title="Alumnos"
            ContentTemplate="{DataTemplate aViews:AlumnosView}"
            Route="AndroidAlumnosView" />
    </TabBar>

</Shell>
