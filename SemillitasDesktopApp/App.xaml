<Application x:Class="SemillitasDesktopApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <!-- Colores y estilos que comparten todas las vistas -->
    <Application.Resources>

        <BooleanToVisibilityConverter x:Key="BoolAVisible" />

        <SolidColorBrush x:Key="Fondo" Color="#F7F5EF" />
        <SolidColorBrush x:Key="Blanco" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Tinta" Color="#1F2A24" />
        <SolidColorBrush x:Key="TintaSuave" Color="#5A655E" />
        <SolidColorBrush x:Key="Linea" Color="#E2DED2" />
        <SolidColorBrush x:Key="BordeCampo" Color="#CFCABB" />
        <SolidColorBrush x:Key="Primario" Color="#2A6F4F" />
        <SolidColorBrush x:Key="PrimarioOscuro" Color="#1F3A2E" />
        <SolidColorBrush x:Key="Seleccion" Color="#EAF3EE" />
        <SolidColorBrush x:Key="VerdeFondo" Color="#DDEFE4" />
        <SolidColorBrush x:Key="VerdeTexto" Color="#1E5A3D" />
        <SolidColorBrush x:Key="AmbarFondo" Color="#FBEBC4" />
        <SolidColorBrush x:Key="AmbarTexto" Color="#7A4B00" />
        <SolidColorBrush x:Key="RojoFondo" Color="#F6D9D2" />
        <SolidColorBrush x:Key="RojoTexto" Color="#8E2A17" />
        <SolidColorBrush x:Key="AzulFondo" Color="#DCE8F5" />
        <SolidColorBrush x:Key="AzulTexto" Color="#1F4E79" />
        <SolidColorBrush x:Key="VeloColor" Color="#66000005" />

        <!-- Textos -->
        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
        </Style>
        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Seccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TintaSuave}" />
        </Style>
        <Style x:Key="Error" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource RojoTexto}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Tarjeta blanca con borde -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Blanco}" />
            <Setter Property="BorderBrush" Value="{StaticResource Linea}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Velo oscuro detrás de los formularios y detalles -->
        <Style x:Key="Velo" TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource VeloColor}" />
        </Style>

        <!-- Botones: una plantilla con esquinas redondeadas y tres colores -->
        <Style x:Key="BotonBase" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Caja" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Caja" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Caja" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource Primario}" />
            <Setter Property="BorderBrush" Value="{StaticResource Primario}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource Blanco}" />
            <Setter Property="BorderBrush" Value="{StaticResource BordeCampo}" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
        </Style>
        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
            <Setter Property="Foreground" Value="{StaticResource RojoTexto}" />
        </Style>

        <!-- Campos -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BordeCampo}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Tablas -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Linea}" />
            <Setter Property="Background" Value="{StaticResource Blanco}" />
            <Setter Property="BorderBrush" Value="{StaticResource Linea}" />
            <Setter Property="RowHeight" Value="46" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Fondo}" />
            <Setter Property="Foreground" Value="{StaticResource TintaSuave}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource Linea}" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Seleccion}" />
                    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Etiqueta de estado. Tono = Verde | Ambar | Rojo -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource VerdeFondo}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tono}" Value="Ambar">
                    <Setter Property="Background" Value="{StaticResource AmbarFondo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="Background" Value="{StaticResource RojoFondo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeTexto" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource VerdeTexto}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tono}" Value="Ambar">
                    <Setter Property="Foreground" Value="{StaticResource AmbarTexto}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tono}" Value="Rojo">
                    <Setter Property="Foreground" Value="{StaticResource RojoTexto}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
