<!--
    Alumnos con su CRUD (DataContext: AlumnosViewModel).
    Lista: TextoBusqueda, ResumenListado, Alumnos[NombreCompleto, Tutor, Telefono, CantidadTalleres, Estado, Tono]
    Formulario: IsFormularioAbierto, TituloFormulario, NombreAlumno, ApellidoAlumno, NombreTutor, Telefono, Errores
    Detalle: IsDetalleAbierto, Detalle, TotalAdeudo, InscripcionesAlumno[Taller, Periodo, Costo, Estado, Tono, PuedeMarcarPago]
    Commands: NuevoCommand, VerDetalleCommand, EditarCommand, EliminarCommand (fila), GuardarCommand, CerrarCommand,
              MarcarPagadoCommand (inscripción)
-->
<UserControl x:Class="SemillitasDesktopApp.Views.AlumnosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Lista -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="+ Nuevo alumno" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoCommand}" VerticalAlignment="Bottom" />
                <StackPanel>
                    <TextBlock Text="Alumnos" Style="{StaticResource Titulo}" />
                    <TextBlock Text="Alumnos, tutores y sus talleres." Style="{StaticResource Subtitulo}" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Buscar" Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Width="320" />
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Alumnos}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ALUMNO" Binding="{Binding NombreCompleto}" Width="2*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="TUTOR" Binding="{Binding Tutor}" Width="1.6*" />
                    <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="*" />
                    <DataGridTextColumn Header="TALLERES" Binding="{Binding CantidadTalleres}" Width="90" />
                    <DataGridTemplateColumn Header="ESTADO" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock Text="{Binding Estado}" Style="{StaticResource BadgeTexto}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="270">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Ver" Style="{StaticResource BotonSecundario}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Editar" Style="{StaticResource BotonSecundario}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Eliminar" Style="{StaticResource BotonPeligro}"
                                            Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" Text="{Binding ResumenListado}" Style="{StaticResource Nota}" Margin="0,10,0,0" />
        </Grid>

        <!-- Formulario nuevo / editar -->
        <Grid Style="{StaticResource Velo}" Visibility="{Binding IsFormularioAbierto, Converter={StaticResource BoolAVisible}}">
            <Border Style="{StaticResource Tarjeta}" Width="600" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource Seccion}" Margin="0,0,0,16" />

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Nombre del alumno" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding NombreAlumno, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="10,0,0,12">
                            <TextBlock Text="Apellidos del alumno" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding ApellidoAlumno, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,12">
                            <TextBlock Text="Nombre del tutor" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding NombreTutor, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="10,0,0,12">
                            <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Lista única de errores -->
                    <ItemsControl ItemsSource="{Binding Errores}" Margin="0,4,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Error}" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource BotonSecundario}" Command="{Binding CerrarCommand}" Margin="0,0,8,0" />
                        <Button Content="Guardar alumno" Style="{StaticResource BotonPrimario}" Command="{Binding GuardarCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Detalle del alumno con sus inscripciones -->
        <Grid Style="{StaticResource Velo}" Visibility="{Binding IsDetalleAbierto, Converter={StaticResource BoolAVisible}}">
            <Border Style="{StaticResource Tarjeta}" Width="760" MaxHeight="640" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Detalle.NombreCompleto}" Style="{StaticResource Seccion}" FontSize="22" Margin="0,0,0,14" />

                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="TUTOR" Style="{StaticResource Nota}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detalle.Tutor}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="TELÉFONO" Style="{StaticResource Nota}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detalle.Telefono}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="ADEUDO" Style="{StaticResource Nota}" FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalAdeudo}" FontWeight="Bold" Foreground="{StaticResource RojoTexto}" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Eliminar" Style="{StaticResource BotonPeligro}" Margin="0,0,8,0"
                                Command="{Binding EliminarCommand}" CommandParameter="{Binding Detalle}" />
                        <Button Content="Editar" Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                                Command="{Binding EditarCommand}" CommandParameter="{Binding Detalle}" />
                        <Button Content="Cerrar" Style="{StaticResource BotonPrimario}" Command="{Binding CerrarCommand}" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Talleres inscritos" Style="{StaticResource Etiqueta}" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding InscripcionesAlumno}" MinHeight="140">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TALLER" Binding="{Binding Taller}" Width="2*" />
                            <DataGridTextColumn Header="PERÍODO" Binding="{Binding Periodo}" Width="*" />
                            <DataGridTextColumn Header="COSTO" Binding="{Binding Costo}" Width="90" />
                            <DataGridTemplateColumn Header="ESTADO" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Text="{Binding Estado}" Style="{StaticResource BadgeTexto}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Marcar pagado" Style="{StaticResource BotonSecundario}"
                                                Visibility="{Binding PuedeMarcarPago, Converter={StaticResource BoolAVisible}}"
                                                Command="{Binding DataContext.MarcarPagadoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
