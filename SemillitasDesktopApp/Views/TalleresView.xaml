<!--
    Catálogo de talleres con su CRUD (DataContext: TalleresViewModel).
    Lista: TextoBusqueda, Catalogo[Nombre, Horario, HorarioSabado, Cupo, Costo]
    Formulario (encima de la lista): IsFormularioAbierto, TituloFormulario, Nombre, NombresCategorias, CategoriaSeleccionada,
         Periodos, PeriodoFormulario, Cupo, Costo, Horas, HoraInicio, HoraFin,
         HorasSabadoInicio, HoraInicioSabado, HorasSabadoFin, HoraFinSabado, Errores
    Detalle (encima de la lista): IsDetalleAbierto, Detalle, DetallePeriodo, Inscritos[Alumno, Tutor, Telefono, Estado, Tono]
    Commands: NuevoCommand, VerDetalleCommand, EditarCommand, EliminarCommand (fila), GuardarCommand, CerrarCommand
-->
<UserControl x:Class="SemillitasDesktopApp.Views.TalleresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Lista -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="+ Nuevo taller" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoCommand}" VerticalAlignment="Bottom" />
                <StackPanel>
                    <TextBlock Text="Talleres" Style="{StaticResource Titulo}" />
                    <TextBlock Text="Crea, edita o elimina talleres." Style="{StaticResource Subtitulo}" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="Buscar" Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Width="300" />
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Catalogo}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TALLER" Binding="{Binding Nombre}" Width="2*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="ENTRE SEMANA" Binding="{Binding Horario}" Width="*" />
                    <DataGridTextColumn Header="SÁBADO" Binding="{Binding HorarioSabado}" Width="*" />
                    <DataGridTextColumn Header="CUPO" Binding="{Binding Cupo}" Width="80" />
                    <DataGridTextColumn Header="COSTO" Binding="{Binding Costo}" Width="90" />
                    <DataGridTemplateColumn Width="270">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Ver" Style="{StaticResource BotonSecundario}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Editar" Style="{StaticResource BotonSecundario}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Eliminar" Style="{StaticResource BotonPeligro}"
                                            Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Formulario nuevo / editar -->
        <Grid Style="{StaticResource Velo}" Visibility="{Binding IsFormularioAbierto, Converter={StaticResource BoolAVisible}}">
            <Border Style="{StaticResource Tarjeta}" Width="640" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource Seccion}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock Text="Nombre del taller" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Categoría" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding NombresCategorias}" SelectedItem="{Binding CategoriaSeleccionada}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Período" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding Periodos}" SelectedItem="{Binding PeriodoFormulario}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                            <TextBlock Text="Cupo (lugares disponibles)" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding Cupo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Costo ($)" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding Costo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,0,0,12">
                            <TextBlock Text="Entre semana: inicio" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding Horas}" SelectedItem="{Binding HoraInicio}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Entre semana: fin" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding Horas}" SelectedItem="{Binding HoraFin}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,0,0,12">
                            <TextBlock Text="Sábado: inicio" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding HorasSabadoInicio}" SelectedItem="{Binding HoraInicioSabado}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Sábado: fin" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding HorasSabadoFin}" SelectedItem="{Binding HoraFinSabado}" />
                        </StackPanel>
                    </Grid>

                    <!-- Lista única de errores -->
                    <ItemsControl ItemsSource="{Binding Errores}" Margin="0,4,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Error}" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource BotonSecundario}" Command="{Binding CerrarCommand}" Margin="0,0,8,0" />
                        <Button Content="Guardar taller" Style="{StaticResource BotonPrimario}" Command="{Binding GuardarCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Detalle del taller con sus inscritos -->
        <Grid Style="{StaticResource Velo}" Visibility="{Binding IsDetalleAbierto, Converter={StaticResource BoolAVisible}}">
            <Border Style="{StaticResource Tarjeta}" Width="760" MaxHeight="640" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Detalle.Nombre}" Style="{StaticResource Seccion}" FontSize="22" Margin="0,0,0,14" />

                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="CATEGORÍA" Style="{StaticResource Nota}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detalle.Categoria}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="ENTRE SEMANA" Style="{StaticResource Nota}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detalle.Horario}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="SÁBADO" Style="{StaticResource Nota}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detalle.HorarioSabado}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="PERÍODO" Style="{StaticResource Nota}" FontWeight="Bold" />
                            <TextBlock Text="{Binding DetallePeriodo}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="COSTO" Style="{StaticResource Nota}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detalle.Costo}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="INSCRITOS / MÁXIMO" Style="{StaticResource Nota}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detalle.Ocupacion}" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Eliminar" Style="{StaticResource BotonPeligro}" Margin="0,0,8,0"
                                Command="{Binding EliminarCommand}" CommandParameter="{Binding Detalle}" />
                        <Button Content="Editar" Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"
                                Command="{Binding EditarCommand}" CommandParameter="{Binding Detalle}" />
                        <Button Content="Cerrar" Style="{StaticResource BotonPrimario}" Command="{Binding CerrarCommand}" />
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Alumnos inscritos" Style="{StaticResource Etiqueta}" Margin="0,0,0,6" />
                    <DataGrid ItemsSource="{Binding Inscritos}" MinHeight="140">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ALUMNO" Binding="{Binding Alumno}" Width="2*" />
                            <DataGridTextColumn Header="TUTOR" Binding="{Binding Tutor}" Width="2*" />
                            <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="*" />
                            <DataGridTemplateColumn Header="ESTADO" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock Text="{Binding Estado}" Style="{StaticResource BadgeTexto}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ACCION" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Eliminar" Style="{StaticResource BotonPeligro}" Margin="0,0,8,0"
                    Command="{Binding DataContext.EliminarAlumnoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                    CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>  
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
