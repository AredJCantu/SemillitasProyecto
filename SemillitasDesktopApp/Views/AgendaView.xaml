<!--
    Agenda del período: talleres agrupados por horario entre semana (DataContext: TalleresViewModel).
    Lee: Periodos, PeriodoSeleccionado, Franjas[Hora, Talleres[Nombre, Categoria, Ocupacion, HorarioSabado]]
    El color de cada tarjeta depende de la categoría.
-->
<UserControl x:Class="SemillitasDesktopApp.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Evento" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Width" Value="220" />
            <Setter Property="Background" Value="{StaticResource AmbarFondo}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Categoria}" Value="Deportes">
                    <Setter Property="Background" Value="{StaticResource VerdeFondo}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Categoria}" Value="Tecnología">
                    <Setter Property="Background" Value="{StaticResource AzulFondo}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Período" Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Periodos}" SelectedItem="{Binding PeriodoSeleccionado}" Width="150" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Agenda" Style="{StaticResource Titulo}" />
                <TextBlock Text="Talleres por horario entre semana. Naranja: arte · Verde: deportes · Azul: tecnología."
                           Style="{StaticResource Subtitulo}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Franjas}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Hora}" Style="{StaticResource Seccion}" Width="130" />
                                <ItemsControl ItemsSource="{Binding Talleres}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Evento}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Ocupacion, StringFormat={}{0} inscritos}" Style="{StaticResource Nota}" />
                                                    <TextBlock Text="{Binding HorarioSabado, StringFormat='Sábado {0}'}" Style="{StaticResource Nota}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
